            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-03-30 19:02:33</dcterms:dateSubmitted>
        <bib:pages>1295-1317</bib:pages>
        <z:citationKey>jonesPartisanshipPoliticalAwareness2020</z:citationKey>
    </bib:Article>
