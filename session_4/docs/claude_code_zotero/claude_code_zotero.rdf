    <bib:Article rdf:about="https://www.cambridge.org/core/journals/american-political-science-review/article/civic-organizations-and-the-political-participation-of-crosspressured-americans-the-case-of-the-labor-movement/A237D4654482E5DDC21CF44B3E75B41A">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>119</prism:volume>
                <dc:title>American Political Science Review</dc:title>
                <dc:identifier>DOI 10.1017/S0003055424000856</dc:identifier>
                <prism:number>3</prism:number>
