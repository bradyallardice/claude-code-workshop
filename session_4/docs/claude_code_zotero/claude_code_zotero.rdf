        <link:link rdf:resource="#item_1498"/>
        <dc:subject>
            <z:AutomaticTag>
               <rdf:value>Ballot initiatives</rdf:value>
            </z:AutomaticTag>
        </dc:subject>
        <dc:subject>
           <z:AutomaticTag><rdf:value>Economic voting</rdf:value></z:AutomaticTag>
        </dc:subject>
        <dc:subject>
            <z:AutomaticTag>
               <rdf:value>Immigration politics</rdf:value>
            </z:AutomaticTag>
