        <dcterms:dateSubmitted>2026-03-30 19:02:03</dcterms:dateSubmitted>
        <bib:pages>443-463</bib:pages>
        <z:citationKey>parkLocalUnemploymentVoting2020</z:citationKey>
    </bib:Article>
