    <bib:Article rdf:about="https://www.cambridge.org/core/journals/american-political-science-review/article/abs/accountability-for-the-local-economy-at-all-levels-of-government-in-united-states-elections/6B61FD69CF47F0DA6E55341A5FF12454">
