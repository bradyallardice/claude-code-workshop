    <bib:Article rdf:about="https://www.journals.uchicago.edu/doi/10.1086/737849">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:0022-3816,%201468-2508"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Chaudoin</foaf:surname>
                        <foaf:givenName>Stephen</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
