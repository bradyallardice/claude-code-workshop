# Sensitive local files
.env
*.pem
*.key
*.secret

# Data locations that should stay out of model context if students add them
data/raw/
data/restricted/
data/*/administrative/

# Zotero import seed: students import this into Zotero.
# PDFs in zotero/pdfs/ intentionally ship for student reading.
# Claude should query Zotero instead of mining the BibTeX directly.
zotero/*.bib

# The Zotero RDF carries the synthesis notes. Claude reads them through the
# Zotero MCP, not from this file.
zotero/capstone_library/capstone_library.rdf
