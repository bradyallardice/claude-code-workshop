# Keep shell scripts LF on every OS. Git for Windows' own bash tolerates CRLF,
# but macOS, Linux and WSL bash fail on it ("set: pipefail: invalid option
# name"). Applies to tools/*.sh and the capstone hooks.
*.sh text eol=lf
*.ps1 text eol=crlf

# ----------------------------------------------------------------------------
# Student export filter. tools/publish.sh builds the public student tree with
# `git archive`, which leaves out every path marked export-ignore here.
# These lines replace the removal pass of the old sync_student.sh.
# Keep tools/student_forbidden.txt in step: publish.sh uses that file as an
# independent check that nothing listed here slipped through.
# Patterns are anchored to the repo root (they contain a slash or a leading /).
# ----------------------------------------------------------------------------

# Instructor-only top-level material
/admin export-ignore
/sync_student.sh export-ignore
/make_demo_branch.sh export-ignore
/start_demo.sh export-ignore
/slides.tex export-ignore
